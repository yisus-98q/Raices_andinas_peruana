# Copia este archivo a .env y ajusta lo que necesites.
# Ninguna variable es obligatoria: todas tienen un valor por defecto.

# Puerto del servidor. 0 = el sistema asigna uno libre (lo usan los tests).
PORT=4000

# En que direccion escucha. Por defecto "::" = todas las interfaces, para poder
# abrir la tienda desde el celular en la misma Wi-Fi. Con 127.0.0.1 solo se ve
# desde esta computadora.
HOST=::

# Ruta del archivo SQLite. Util para separar demo, pruebas y produccion.
DB_PATH=./data/tienda.db

# Primer acceso al panel. Solo se usan la PRIMERA vez que arranca, cuando
# todavia no hay ningun usuario creado. Despues se gestionan con clave.mjs.
ADMIN_EMAIL=hola@raizandina.pe
ADMIN_PASSWORD=cambia-esta-clave

# Opcional: si esta definida, el asesor redacta con Claude en vez de usar
# solo el motor de reglas. Requiere `npm install @anthropic-ai/sdk`.
# Sin ella la tienda funciona igual, y sin internet.
ANTHROPIC_API_KEY=

# Solo para la suite de tests: desactiva las cuotas por IP.
# NUNCA ponerla a 1 en produccion.
SIN_LIMITES=0
